---
// Deux colonnes de services : une par public (employeurs / employés)
export interface Props {
  audiences: { id: string; label: string; sectionLabel?: string; title: string; intro?: string; items: string[] }[];
}

const { audiences } = Astro.props;
---

<section class="section">
  <div class="container-audex">
    <div class="audience-grid">
      {audiences.map((a, i) => (
        <article id={a.id} class={`audience-panel audience-panel-${i}`}>
          {a.sectionLabel && <p class="audience-eyebrow">{a.sectionLabel}</p>}
          <h2>{a.title}</h2>
          {a.intro && <p class="audience-intro">{a.intro}</p>}
          <ul class="audience-list">
            {a.items.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .audience-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 900px) {
    .audience-grid { grid-template-columns: 1fr 1fr; gap: 2rem; }
  }
  .audience-panel {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-top: 4px solid var(--color-gold);
    border-radius: var(--radius-lg);
    padding: 2rem 1.75rem;
    scroll-margin-top: 110px;
  }
  .audience-panel-1 { border-top-color: var(--color-navy); }
  .audience-eyebrow {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-gold-hover);
    margin-bottom: 0.5rem;
  }
  .audience-panel h2 {
    font-size: clamp(1.4rem, 2.6vw, 1.8rem);
    line-height: 1.25;
    margin-bottom: 1rem;
  }
  .audience-intro {
    color: #555;
    line-height: 1.65;
    margin-bottom: 1.25rem;
  }
  .audience-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.65rem;
  }
  .audience-list li {
    position: relative;
    padding-left: 1.6rem;
    line-height: 1.55;
  }
  .audience-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    top: 0;
    font-weight: 700;
    color: var(--color-gold);
  }
</style>
