---
// « Comment ça fonctionne » + encadré « partout au Québec »
export interface Props {
  title: string;
  steps: { title: string; text: string }[];
  areaTitle?: string;
  areaText?: string;
  areaCities?: string[];
  areaOffices?: string;
}

const { title, steps, areaTitle, areaText, areaCities = [], areaOffices } = Astro.props;
// Le contenu source termine les titres par un point (« Décrivez votre besoin. ») ; on l'enlève à l'affichage
const clean = (t: string) => t.replace(/\.\s*$/, '');
---

<section class="section">
  <div class="container-audex">
    <h2 class="steps-title">{title}</h2>
    <ol class="steps-grid">
      {steps.map((s, i) => (
        <li class="step">
          <span class="step-num" aria-hidden="true">{i + 1}</span>
          <h3>{clean(s.title)}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>

    {areaTitle && (
      <div class="area-box">
        <div class="area-text">
          <h3>{clean(areaTitle)}</h3>
          {areaText && <p>{areaText}</p>}
        </div>
        {(areaCities.length > 0 || areaOffices) && (
          <ul class="area-chips" aria-label="Régions desservies">
            {areaCities.map((c) => <li>{c}</li>)}
            {areaOffices && <li class="area-chip-offices">{areaOffices}</li>}
          </ul>
        )}
      </div>
    )}
  </div>
</section>

<style>
  .steps-title { margin-bottom: 2rem; }
  .steps-grid {
    list-style: none;
    padding: 0;
    margin: 0 0 2.5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }
  @media (min-width: 640px) { .steps-grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .steps-grid { grid-template-columns: repeat(4, 1fr); } }
  .step-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background: var(--color-navy);
    color: var(--color-gold);
    font-weight: 700;
    margin-bottom: 0.9rem;
  }
  .step h3 { font-size: 1.1rem; margin-bottom: 0.5rem; }
  .step p { color: #555; line-height: 1.6; margin: 0; }

  .area-box {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    background: var(--color-navy);
    color: var(--color-white);
    border-radius: var(--radius-lg);
    padding: 2rem 1.75rem;
  }
  @media (min-width: 900px) { .area-box { grid-template-columns: 1.1fr 1fr; align-items: center; gap: 2.5rem; padding: 2.25rem 2.5rem; } }
  .area-text h3 { color: var(--color-white); font-size: 1.35rem; margin-bottom: 0.6rem; }
  .area-text p { color: rgba(255, 255, 255, 0.85); line-height: 1.65; margin: 0; }
  .area-chips { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .area-chips li {
    padding: 0.35rem 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 50px;
    font-size: 0.85rem;
  }
  .area-chips .area-chip-offices {
    background: var(--color-gold);
    border-color: var(--color-gold);
    color: var(--color-navy);
    font-weight: 700;
  }
</style>
