---
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import HeroInternal from '../components/sections/HeroInternal.astro';
import ServiceOfferings from '../components/sections/ServiceOfferings.astro';
import TestimonialSingle from '../components/sections/TestimonialSingle.astro';
import FAQ from '../components/sections/FAQ.astro';
import FAQGrouped from '../components/sections/FAQGrouped.astro';
import CtaBlock from '../components/sections/CtaBlock.astro';
import ServicesConnexes from '../components/sections/ServicesConnexes.astro';
import ServiceTeam from '../components/sections/ServiceTeam.astro';
import AudienceCards from '../components/sections/AudienceCards.astro';
import AudienceServices from '../components/sections/AudienceServices.astro';
import WhyChoose from '../components/sections/WhyChoose.astro';
import PricingPackages, { type PackageItem } from '../components/sections/PricingPackages.astro';
import PackageSteps from '../components/sections/PackageSteps.astro';
import PrequalForm from '../components/forms/PrequalForm.astro';
import { company } from '../data/company';
import { offices } from '../data/offices';

type Audience = {
  id: string;
  label: string;
  sectionLabel?: string;
  cardTitle: string;
  cardText?: string;
  title: string;
  intro?: string;
  items: string[];
  faqTitle?: string;
  schemaType?: string;
  schemaName?: string;
};

export interface Props {
  title: string;
  shortTitle: string;
  seoTitle: string;
  seoDescription: string;
  heroTitle: string;
  heroSubtitle: string;
  heroImage?: string;
  heroImageWebp?: string;
  heroImageAlt?: string;
  heroEyebrow?: string;
  updatedDate?: Date;
  introTitle?: string;
  offeringsTitle?: string;
  offeringsSubtitle?: string;
  offerings: { title: string; description: string }[];
  highlight?: { title: string; description: string };
  testimonial?: { quote: string; author?: string };
  audiences?: Audience[];
  whyTitle?: string;
  whyItems?: { title: string; description: string }[];
  faq: { question: string; answer: string; group?: string }[];
  ctaText?: string;
  ctaSubtitle?: string;
  packagesTitle?: string;
  packagesIntro?: string;
  packagesStartOptions?: { title: string; text: string }[];
  packageGroups?: { label: string; items: (PackageItem & { prices: { amount: number; label?: string; schemaName?: string }[] })[] }[];
  packagesTerms?: string;
  stepsTitle?: string;
  steps?: { title: string; text: string }[];
  areaTitle?: string;
  areaText?: string;
  areaCities?: string[];
  areaOffices?: string;
  prequalTitle?: string;
  prequalIntro?: string;
  schemaName?: string;
  knowsAbout?: string[];
  relatedServices?: string[];
  serviceSlug?: string;
}

const props = Astro.props;

const teamMembers = props.serviceSlug
  ? (await getCollection('team'))
      .filter(m => !m.data.mascot && m.data.practiceAreas.includes(props.serviceSlug!))
      .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  : [];

// Gabarit « deux publics » : activé quand la page définit des publics (audiences)
const audiences = props.audiences ?? [];
const isAudienceLayout = audiences.length > 0;

const faqGroups = audiences
  .map((a) => ({
    id: a.id,
    title: a.faqTitle ?? a.label,
    items: props.faq.filter((q) => q.group === a.id),
  }))
  .filter((g) => g.items.length > 0);

// Données structurées JSON-LD (page, service, FAQ) — générées à partir du contenu visible
const stripHtml = (html: string) => html.replace(/<[^>]*>/g, '').replace(/\s+/g, ' ').trim();
const pageUrl = props.serviceSlug ? new URL(`/services/${props.serviceSlug}/`, Astro.site).toString() : undefined;

// Forfaits à prix fixe : activés quand la page définit des groupes de forfaits
const packageGroups = props.packageGroups ?? [];
const allPackages = packageGroups.flatMap((g) => g.items);
const hasPackages = allPackages.length > 0;
const faqForSchema = isAudienceLayout ? faqGroups.flatMap((g) => g.items) : props.faq;

const jsonLd = (isAudienceLayout || hasPackages) && pageUrl
  ? {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'WebPage',
          '@id': pageUrl,
          url: pageUrl,
          name: props.seoTitle,
          inLanguage: 'fr-CA',
          ...(props.updatedDate ? { dateModified: props.updatedDate.toISOString().slice(0, 10) } : {}),
          about: { '@id': `${pageUrl}#service` },
        },
        {
          '@type': 'LegalService',
          '@id': `${pageUrl}#service`,
          name: props.schemaName ?? `${company.name} – ${props.title}`,
          url: pageUrl,
          telephone: `+1-${company.phone}`,
          ...(hasPackages ? { email: company.email } : {}),
          address: offices.map((o) => ({
            '@type': 'PostalAddress',
            streetAddress: o.address,
            addressLocality: o.name,
            addressRegion: 'QC',
            postalCode: o.postalCode,
            addressCountry: 'CA',
          })),
          areaServed: {
            '@type': 'AdministrativeArea',
            name: 'Québec',
            containedInPlace: { '@type': 'Country', name: 'Canada' },
          },
          availableChannel: {
            '@type': 'ServiceChannel',
            name: 'Consultation en personne ou à distance',
          },
          ...(props.knowsAbout?.length ? { knowsAbout: props.knowsAbout } : {}),
          ...(isAudienceLayout
            ? {
                audience: audiences
                  .filter((a) => a.schemaType && a.schemaName)
                  .map((a) => ({ '@type': a.schemaType, name: a.schemaName })),
              }
            : {}),
          ...(hasPackages
            ? {
                hasOfferCatalog: {
                  '@type': 'OfferCatalog',
                  name: `Forfaits en ${props.shortTitle.charAt(0).toLowerCase()}${props.shortTitle.slice(1)}`,
                  itemListElement: allPackages.flatMap((p) =>
                    p.prices.map((pr) => ({
                      '@type': 'Offer',
                      name: pr.schemaName ?? p.name,
                      price: String(pr.amount),
                      priceCurrency: 'CAD',
                    }))
                  ),
                },
              }
            : {}),
        },
        ...(faqForSchema.length
          ? [
              {
                '@type': 'FAQPage',
                '@id': `${pageUrl}#faq`,
                mainEntity: faqForSchema.map((q) => ({
                  '@type': 'Question',
                  name: q.question,
                  acceptedAnswer: { '@type': 'Answer', text: stripHtml(q.answer) },
                })),
              },
            ]
          : []),
      ],
    }
  : undefined;

const teamTitle = props.shortTitle.charAt(0).toLowerCase() + props.shortTitle.slice(1);
---

<BaseLayout title={props.seoTitle} description={props.seoDescription} headerSolid>
  {jsonLd && (
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )}

  <HeroInternal
    title={props.heroTitle}
    subtitle={props.heroSubtitle}
    image={props.heroImage}
    imageWebp={props.heroImageWebp}
    imageAlt={props.heroImageAlt}
    eyebrow={props.heroEyebrow}
    breadcrumb={[
      { label: 'Nos services', href: '/#services' },
      { label: props.shortTitle },
    ]}
  >
    {isAudienceLayout && <AudienceCards audiences={audiences} updatedDate={props.updatedDate} />}
  </HeroInternal>

  {isAudienceLayout ? (
    <>
      <AudienceServices audiences={audiences} />

      {props.whyItems && props.whyItems.length > 0 && (
        <WhyChoose title={props.whyTitle ?? 'Pourquoi choisir Audex'} items={props.whyItems} />
      )}

      <ServiceTeam members={teamMembers} serviceTitle={teamTitle} />

      {faqGroups.length > 0 && <FAQGrouped groups={faqGroups} />}

      <CtaBlock title={props.ctaText} subtitle={props.ctaSubtitle} />
    </>
  ) : (
    <>
      {props.introTitle && (
        <section class="section">
          <div class="container-audex">
            <div class="about-content">
              <h2>{props.introTitle}</h2>
              <slot name="intro" />
            </div>
          </div>
        </section>
      )}

      <ServiceOfferings
        title={props.offeringsTitle}
        subtitle={props.offeringsSubtitle}
        offerings={props.offerings}
        highlight={props.highlight}
      />

      {hasPackages && (
        <PricingPackages
          title={props.packagesTitle ?? 'Nos forfaits'}
          intro={props.packagesIntro}
          startOptions={props.packagesStartOptions}
          groups={packageGroups}
          terms={props.packagesTerms}
        />
      )}

      {props.steps && props.steps.length > 0 && (
        <PackageSteps
          title={props.stepsTitle ?? 'Comment ça fonctionne'}
          steps={props.steps}
          areaTitle={props.areaTitle}
          areaText={props.areaText}
          areaCities={props.areaCities}
          areaOffices={props.areaOffices}
        />
      )}

      {hasPackages && props.prequalTitle && (
        <PrequalForm title={props.prequalTitle} intro={props.prequalIntro} packages={allPackages} />
      )}

      {props.testimonial && (
        <TestimonialSingle quote={props.testimonial.quote} author={props.testimonial.author} />
      )}

      <FAQ items={props.faq} />

      <ServiceTeam members={teamMembers} serviceTitle={props.shortTitle} />

      <CtaBlock title={props.ctaText} />
    </>
  )}

  {props.relatedServices && props.relatedServices.length > 0 && (
    <ServicesConnexes slugs={props.relatedServices} />
  )}
</BaseLayout>
